


adv_coeff = 1.0
batch_size = 256
buffer = <xRLAgents.agents.trajectory_buffer_discrete.TrajectoryBufferDiscrete object at 0x7f8637f5f230>
device = cuda
entropy_beta = 0.01
envs = <xRLAgents.training.vectorized_atari_wrapper.VectorizedAtariWrapper object at 0x7f8686ca6a50>
envs_count = 128
eps_clip = 0.2
gamma = 0.99
lam = 0.95
max_grad_norm = 0.5
model = CNNActorCriticDiscrete(
  (encoder): ModelFeatures(
    (model): Sequential(
      (0): Conv2d(4, 32, kernel_size=(3, 3), stride=(2, 2), padding=(1, 1))
      (1): SiLU()
      (2): Conv2d(32, 64, kernel_size=(3, 3), stride=(2, 2), padding=(1, 1))
      (3): SiLU()
      (4): Conv2d(64, 64, kernel_size=(3, 3), stride=(2, 2), padding=(1, 1))
      (5): SiLU()
      (6): Conv2d(64, 128, kernel_size=(3, 3), stride=(1, 1), padding=(1, 1))
      (7): SiLU()
      (8): Flatten(start_dim=1, end_dim=-1)
      (9): Linear(in_features=18432, out_features=512, bias=True)
    )
  )
  (actor): ModelMLP(
    (lin_0): Linear(in_features=512, out_features=256, bias=True)
    (act_0): SiLU()
    (lin_1): Linear(in_features=256, out_features=9, bias=True)
  )
  (critic): ModelMLP(
    (lin_0): Linear(in_features=512, out_features=256, bias=True)
    (act_0): SiLU()
    (lin_1): Linear(in_features=256, out_features=1, bias=True)
  )
)
n_ppo_episodes = 4
n_ppo_steps = 128
num_actions = 9
optimizer = Adam (
Parameter Group 0
    amsgrad: False
    betas: (0.9, 0.999)
    capturable: False
    decoupled_weight_decay: False
    differentiable: False
    eps: 1e-05
    foreach: None
    fused: None
    lr: 0.00025
    maximize: False
    weight_decay: 0
)
ppo_logger = <xRLAgents.training.ppo_discrete_logger.PPODiscreteLogger object at 0x7f8637cd8ad0>
state_shape = (4, 96, 96)
val_coeff = 0.5



